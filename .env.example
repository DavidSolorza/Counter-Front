# ==========================================
# Counter Frontend - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env y define tus credenciales locales.
# ==========================================

# Backend Flask (Analítica y Telemetría)
VITE_API_BASE_URL=http://127.0.0.1:5000/api/v1

# Microservicio Spring Boot (Autenticación y Licencias)
VITE_AUTH_BASE_URL=http://localhost:8080/api/v1/auth

# GitHub OAuth 2.0 Client ID (Proporcionado en GitHub Developer Settings)
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# Google OAuth 2.0 Client ID (Proporcionado en Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Licencia del Cliente por Defecto
VITE_DEFAULT_SITE_KEY=wk_live_demo
